@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700;900&display=swap");

:root {
  --bg-main: #f4f0ea;
  --bg-card: #ffffff;
  --bg-accent: #ccff00;
  --color-black: #0d0d0d;
  --border-brutal: 3px solid #0d0d0d;
  --shadow-brutal: 5px 5px 0px #0d0d0d;
  --shadow-brutal-sm: 3px 3px 0px #0d0d0d;
  --color-positive: #00e676; 
  --color-negative: #ff3366; 
  --font-main: "Space Grotesk", sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  background-color: var(--bg-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  margin: 0;
  padding: 2rem 1rem;
  font-family: var(--font-main);
  color: var(--color-black);
  
  background-image: 
    linear-gradient(to right, rgba(13, 13, 13, 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(13, 13, 13, 0.05) 1px, transparent 1px);
  background-size: 30px 30px;
}

.container {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1.8fr;
  padding: 0;
  gap: 1.5rem;
  width: 100%;
  max-width: 1200px;
}

h1 {
  letter-spacing: -1px;
  color: var(--color-black);
  font-weight: 900;
  text-transform: uppercase;
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
  text-shadow: 2px 2px 0px var(--bg-accent);
}

.title {
  color: var(--color-black);
  font-weight: 700;
}

h3 {
  padding-top: 0;
  margin: 0;
  font-weight: 700;
  text-transform: uppercase;
}

.montante {
  color: var(--color-black);
  font-size: 2rem;
  font-weight: 900;
}

.item {
  padding: 1.5rem;
  background-color: var(--bg-card);
  border: var(--border-brutal);
  box-shadow: var(--shadow-brutal);
  border-radius: 0px; /* Sem cantos arredondados suavizados */
}

h4 {
  margin: 0;
  text-transform: uppercase;
  border-bottom: var(--border-brutal);
  padding-bottom: 10px;
  font-weight: 900;
  font-size: 1.1rem;
  letter-spacing: 0.5px;
}

.inc-exp-container {
  flex-direction: column;
  background-color: var(--bg-accent);
  border: var(--border-brutal);
  box-shadow: var(--shadow-brutal);
  padding: 1.5rem;
  display: flex;
  justify-content: space-between;
  margin: 1.5rem 0 0 0;
  border-radius: 0px;
}

.inc-exp-container > div {
  flex: 1;
  text-align: left;
  padding: 0.5rem 0;
}

.inc-exp-container > div:first-of-type {
  border-bottom: var(--border-brutal);
}

.din {
  font-size: 1.5rem;
  font-weight: 900;
  letter-spacing: 0px;
  margin: 5px 0;
}

.din.positivo {
  color: var(--color-black);
  background-color: var(--color-positive);
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border: 2px solid var(--color-black);
  box-shadow: 2px 2px 0px var(--color-black);
}

.din.negativo {
  color: #ffffff;
  background-color: var(--color-negative);
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border: 2px solid var(--color-black);
  box-shadow: 2px 2px 0px var(--color-black);
}

label {
  display: inline-block;
  margin: 10px 0 5px 0;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.9rem;
}

input[type="text"],
input[type="number"] {
  border: var(--border-brutal);
  border-radius: 0px;
  display: block;
  font-family: var(--font-main);
  font-size: 1rem;
  font-weight: 700;
  margin: 5px 0 15px 0;
  padding: 12px;
  width: 100%;
  background-color: var(--bg-card);
  outline: none;
  transition: transform 0.1s ease;
}

input[type="text"]:focus,
input[type="number"]:focus {
  background-color: #ffffff;
  box-shadow: var(--shadow-brutal-sm);
  transform: translate(-2px, -2px);
}

.btn {
  cursor: pointer;
  background-color: var(--color-black);
  color: #ffffff;
  border: var(--border-brutal);
  box-shadow: var(--shadow-brutal);
  display: block;
  font-family: var(--font-main);
  font-size: 1rem;
  font-weight: 900;
  text-transform: uppercase;
  margin: 15px 0 10px;
  padding: 12px;
  width: 100%;
  border-radius: 0px;
  transition: transform 0.1s ease, box-shadow 0.1s ease, background-color 0.1s ease;
}

.btn:hover {
  background-color: var(--bg-accent);
  color: var(--color-black);
  transform: translate(-2px, -2px);
  box-shadow: 7px 7px 0px var(--color-black);
}

.btn:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0px var(--color-black);
}

.btn:focus,
.delete-btn:focus {
  outline: 0;
}

.transacoes {
  list-style-type: none;
  padding: 0;
  margin: 15px 0 40px 0;
}

.transacoes li {
  background-color: var(--bg-card);
  border: var(--border-brutal);
  box-shadow: var(--shadow-brutal-sm);
  color: var(--color-black);
  font-weight: 700;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  padding: 12px;
  margin-bottom: 12px;
  border-radius: 0px;
}

.transacoes li.positivo {
  border-right: 10px solid var(--color-positive);
}

.transacoes li.negativo {
  border-right: 10px solid var(--color-negative);
}

.delete-btn {
  cursor: pointer;
  background-color: var(--color-negative);
  border: 2px solid var(--color-black);
  color: #ffffff;
  font-family: var(--font-main);
  font-weight: 900;
  font-size: 16px;
  padding: 5px 10px;
  position: absolute;
  top: 50%;
  right: -50px;
  transform: translateY(-50%);
  opacity: 0;
  box-shadow: 2px 2px 0px var(--color-black);
  transition: opacity 0.2s ease, transform 0.2s ease;
  border-radius: 0px;
}

.transacoes li:hover .delete-btn {
  opacity: 1;
}

.delete-btn:hover {
  background-color: var(--color-black);
  color: #ffffff;
}

@media screen and (max-width: 900px) {
  .container {
    grid-template-columns: 1fr;
  }
  
  .delete-btn {
    position: static;
    transform: none;
    opacity: 1;
    margin-left: 10px;
  }
}


@import url("https://fonts.googleapis.com/css2?family=Varela+Round&display=swap");

body {
  background-color: #512da8;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 30vh;
  max-height: 50vh;
  margin: 0;
  font-family: "Varela Round", sans-serif;
  color: #d1c4e9;
}

.container {
  display: grid;
  grid-template-columns: 1fr 1.5fr 2fr;
  padding: 10px;
  gap: 10px;
  width: 95vw;
}

h1 {
  letter-spacing: 1px;
  color: #ffffff;
}

.title {
  color: #d1c4e9;
}

h3 {
  padding-top: 10px;
  margin: 0;
}

.montante {
  color: #757575;
}

.item {
  padding: 15px;
  background-color: #e040fb;
  border-radius: 10px;
}

h4 {
  margin: 0;
  text-transform: uppercase;
  border-bottom: 1px solid #bbb;
  padding-bottom: 10px;
}

.inc-exp-container {
  flex-direction: column;
  background-color: #fff;
  box-shadow: var(--box-shadow);
  padding: 20px;
  display: flex;
  justify-content: space-between;
  margin: 20px 0;
}

.inc-exp-container > div {
  flex: 1;
  text-align: left;
}

.inc-exp-container > div:first-of-type {
  border-bottom: 1px solid #dedede;
}

.din {
  font-size: 20px;
  letter-spacing: 1px;
  margin: 5px 0;
}

.din.positivo {
  color: #2ecc71;
}

.din.negativo {
  color: #c0392b;
}

label {
  display: inline-block;
  margin: 10px 0;
}

input[type="text"],
input[type="number"] {
  border: 1px solid #dedede;
  border-radius: 2px;
  display: block;
  font-size: 16px;
  margin: 10px 0 10px;
  padding: 10px;
  width: 95%;
}

.btn {
  cursor: pointer;
  background-color: #512da8;
  box-shadow: var(--box-shadow);
  color: #fff;
  border: 0;
  display: block;
  font-size: 18px;
  margin: 10px 0 10px;
  padding: 10px;
  width: 100%;
  border-radius: 10px;
}

.btn:focus,
.delete-btn:focus {
  outline: 0;
}

.transacoes {
  list-style-type: none;
  padding: 0;
  margin-bottom: 40px;
}

.transacoes li {
  background-color: #ffffff;
  box-shadow: var(--box-shadow);
  color: #212121;
  display: flex;
  justify-content: space-between;
  position: relative;
  padding: 10px;
  margin: 2px 30px 0px 0px;
  border-radius: 2px;
}

.transacoes li.positivo {
  border-right: 7px solid #2ecc71;
}

.transacoes li.negativo {
  border-right: 7px solid #c0392b;
}

.delete-btn {
  cursor: pointer;
  background-color: #ff5722;
  border: 0;
  color: #fff;
  font-size: 20px;
  line-height: 20px;
  padding: 10px 10px;
  position: absolute;
  top: 50%;
  right: -14%;
  transform: translate(-100%, -50%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.transacoes li:hover .delete-btn {
  opacity: 1;
}

@media screen and (max-width: 900px) {
  .container {
    grid-template-columns: 1fr;
  }
}
